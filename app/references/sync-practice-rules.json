{
  "version": "1.0",
  "title": "同步练习 / 课时同步材料的题型与组题判定口径",
  "origin": "26秋《课时A计划》英语 RJ 七上·八上·九上（学用）正文 854 处大题实测 + 已上传同系列批次反查",
  "applies_to": {
    "source_type": ["同步练习"],
    "material_hint": ["课时", "Section A", "Section B", "基础", "提升", "课时A计划"],
    "note": "仅用于同步练习册/课时同步练习类材料：按课时编排、每课时通常分基础段与提升段（提升段题号从 Ⅰ 重新开始）。单元卷、期中期末卷、中高考真题不套用本口径。"
  },
  "granularity": {
    "standalone": "每个小题自带独立提示语、独立题干、可单独成题（单项填空、单词拼写、完成句子、翻译、改错、书面表达、一句一空的语法填空）。",
    "group": "共用一段语篇/对话/表格/方框/图片的整题（完形、阅读、任务型阅读、补全对话、选词填空、短文填空、教材语篇填空、语音题整大题、看图写句子）。判据是“是否共用同一材料”，不是“题号是否连续”。",
    "unit_kind_frozen": "unit_kind 在结构确认阶段定死，后续阶段不得改写。"
  },
  "type_kind": {
    "听力短对话理解": "group",
    "听力长对话理解": "group",
    "听力短文理解": "group",
    "听力信息转换": "group",
    "听力判断": "group",
    "听力排序": "group",
    "听力问答": "group",
    "听力关键词语选择": "group",
    "听力其他": "group",
    "语音题": "group",
    "单项填空": "standalone",
    "完形填空": "group",
    "语法选择": "group",
    "阅读理解": "group",
    "任务型阅读": "group",
    "教材语篇填空": "group",
    "短文填空": "group",
    "选词填空": "group",
    "补全对话": "group",
    "单词拼写": "standalone",
    "完成句子": "standalone",
    "情景运用": "group",
    "翻译": "standalone",
    "改错": "standalone",
    "读写综合": "group",
    "书面表达": "standalone",
    "其他": "standalone"
  },
  "rules": [
    {
      "id": "cloze",
      "any": ["完形填空"],
      "none": ["☆拓展设问"],
      "type": "完形填空",
      "subtype": null,
      "kind": "group",
      "note": "子类按正文空数选 5空/10空/15空/其他空数；同步练习册以 10 空为主。☆拓展设问不是第 N 空，不得计入空数。"
    },
    {
      "id": "reading",
      "any": ["阅读理解"],
      "type": "阅读理解",
      "subtype": null,
      "kind": "group",
      "note": "子类按实际小题数选 选择3题/选择4题/选择5题；[情境题]/[跨学科]/[原创]/[20XX·XX] 只是命题标签，不改变题型，标签不进原卷标题。"
    },
    {
      "id": "task-reading-mindmap",
      "any": ["完成任务思维导图", "完成思维导图"],
      "type": "任务型阅读",
      "subtype": "信息摘录",
      "kind": "group",
      "note": "短文后要求填思维导图（每空不超过 N 个词）属信息摘录。"
    },
    {
      "id": "task-reading",
      "any": ["任务型阅读"],
      "type": "任务型阅读",
      "subtype": null,
      "kind": "group",
      "note": "纯“根据短文内容回答问题/不超过N个词”记 阅读问答；同题混排问答+选择+排序+填表/思维导图记 阅读综合。判据只看本大题主题干与正文，不看 ☆拓展设问。"
    },
    {
      "id": "dialogue",
      "any": ["补全对话", "完成对话"],
      "type": "补全对话",
      "subtype": null,
      "kind": "group",
      "note": "A–G 七选五整块选项记 7选5；给出特殊疑问词/词组让填一格记 填写单词。两种都按整题组收录（用户 2026-11-10 定）。"
    },
    {
      "id": "textbook-review",
      "any": ["教材语篇回顾"],
      "type": "教材语篇填空",
      "subtype": "人教版",
      "kind": "group",
      "note": "教材语篇回顾 = 课文要点表格挖空，按 教材语篇填空/人教版 收录。"
    },
    {
      "id": "passage-fill",
      "any": ["根据短文内容"],
      "subtype_any": ["填空"],
      "type": "短文填空",
      "subtype": null,
      "kind": "group",
      "note": "“根据短文内容(或/及)所给提示填空”统一记 短文填空（无子类），不再记 教材语篇填空；八上同书已上传批次即此口径。"
    },
    {
      "id": "word-bank",
      "any": ["用方框"],
      "type": "选词填空",
      "subtype": "多句",
      "kind": "group",
      "note": "同步练习册的方框题一律是若干个单句 + 方框词（含“每词限用一次”），记 多句；整篇语篇挖空才记 短文。"
    },
    {
      "id": "phonetic-bank",
      "any": ["根据音标从方框中选择"],
      "type": "单词拼写",
      "subtype": "句意及音标",
      "kind": "group",
      "note": "方框给词、每空给音标，整题共用方框。"
    },
    {
      "id": "phonetic-write",
      "any": ["根据所给音标写出单词", "根据音标写出单词"],
      "type": "单词拼写",
      "subtype": "句意及音标",
      "kind": "group",
      "note": "Pronunciation 栏目内的音标写单词整题记组题（用户 2026-11-11 定）。"
    },
    {
      "id": "phonetic-whole",
      "any": ["音素", "歌谣", "音标分类", "按音标", "字母表顺序", "字母顺序", "大小写", "元音字母",
              "读音是否相同", "所缺字母", "读音不同", "读音相同的单词", "画线部分的读音",
              "发音与所给音标", "所给音标相同的单词", "图片及所给音标"],
      "type": "语音题",
      "subtype": null,
      "kind": "group",
      "note": "Pronunciation 栏目的语音题整大题一律记组题（用户 2026-11-11 定，含辨音选择、音标选词、字母表补全、大小写判断、音素归类、歌谣归类）。"
    },
    {
      "id": "sentence-rewrite",
      "any": ["按要求完成句子", "合并为一句", "改为含有宾语从句的复合句", "扩写"],
      "type": "完成句子",
      "subtype": "改写句子",
      "kind": "standalone",
      "note": "大题级记 改写句子；同一大题内若混有划线提问/同义句，逐题上传时按小题定子类。"
    },
    {
      "id": "sentence-question",
      "any": ["对画线部分提问", "就画线部分提问"],
      "type": "完成句子",
      "subtype": "划线提问",
      "kind": "standalone"
    },
    {
      "id": "sentence-synonym",
      "any": ["同义句"],
      "type": "完成句子",
      "subtype": "同义句转化",
      "kind": "standalone"
    },
    {
      "id": "sentence-chinese",
      "any": ["根据汉语意思完成句子", "根据汉语提示完成句子", "根据汉语提示完成下列句子"],
      "type": "完成句子",
      "subtype": "汉语提示",
      "kind": "standalone"
    },
    {
      "id": "sentence-fill",
      "any": ["根据所给提示补全句子"],
      "type": "完成句子",
      "subtype": "汉语提示",
      "kind": "standalone",
      "note": "“根据所给提示补全句子，每空一词”与根据汉语意思完成句子同类。"
    },
    {
      "id": "spell-abbreviation",
      "any": ["缩写词的完全形式", "缩写词"],
      "type": "单词拼写",
      "subtype": "词形转换",
      "kind": "standalone",
      "note": "写出缩写词的完全形式，逐条按小题记录（7a 先例 RJ7A-U1-01 系列）。"
    },
    {
      "id": "spell-word-game",
      "any": ["填词游戏"],
      "type": "单词拼写",
      "subtype": "汉语提示",
      "kind": "group",
      "note": "表格填词游戏共用一张格盘，整题记组题（7a 先例 RJ7A-U1-02-303）。"
    },
    {
      "id": "spell-initial",
      "any": ["根据首字母及汉语提示补全单词", "根据首字母及汉语提示完成单词",
