{
  "provider": "command",
  "command": ["my-agent", "--prompt-file", "{prompt_file}", "--response-file", "{response_file}"],
  "response_mode": "file",
  "input_mode": "none",
  "timeout_seconds": 900,
  "max_input_chars": 180000,
  "retries": 1,
  "retry_feedback_chars": 1200,
  "unit_split": true,
  "assemble_part_units": 8,
  "review_part_units": 15,
  "part_concurrency": 16,
  "candidate_cache": false
}
