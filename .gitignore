# 生成物（运行时由宿主插件写出，不随仓库迁移）
backend/.local-agent.effective.json
backend/.local-agent.effective.json.tmp-*

# 运行时试卷数据（上传批次与暂存，不随代码提交）
/workflows/
/inbox/
/.workbench-trash/
# 原生内容子智能体队列/取证快照（含试卷原文，不入库）
/.content-agent/
/.content-agent-*-tests*.log

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store
._*

# 编辑器/临时文件
*.tmp
node_modules/

# 本地验证、记忆与人工备份，不属于发布代码
/backend/diagnostics/
/backend-regression-review-status*.log
/.mnemon/
/.verification/
/app/workflows/
/app/workflow/batch_fill.py.bak


# 随插件分发的运行时二进制（体积大，发布前用 fetch_vendor.py 拉进 vendor，不进 git）
app/audio/vendor/python/
app/audio/vendor/ffmpeg/

# 听力切段运行时数据根（venv/模型/状态，体积大，每台机器自建，绝不进仓库）
/audio/
.port-backup/

# 每台设备明确授权的本地运维安装能力，不随源码或隔离副本分发
/.operations-autonomy.json

# DSH office 预览/渲染临时目录（每次运行随机后缀，属本机产物）
/.dsh-office-*/
app/workflow/local-agent.json.bak-*
